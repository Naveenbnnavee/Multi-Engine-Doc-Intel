# ==============================================================================
# Multi-Engine Document Intelligence (PDF Chatter) Environment Variables
# ==============================================================================
# Copy this file to .env for local development.
# In production (e.g., Render, Railway, Hugging Face Spaces), set these in the dashboard:
#   Dashboard > Environment Variables
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Google Gemini API Key for Document Embeddings & Contextual Synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Port (Defaults to 8000 locally, 10000 on Render)
PORT=8000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=https://multi-engine-doc-intel.vercel.app,https://multi-engine-doc-intel.onrender.com,http://localhost:5173,http://localhost:3000
